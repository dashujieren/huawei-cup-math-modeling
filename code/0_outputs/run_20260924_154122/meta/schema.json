{
  "format": "UTF-8 CSV; empty field means not applicable, not zero",
  "coordinate_systems": {
    "lon_deg/lat_deg": "EPSG:4326",
    "x_m/y_m": "EPSG:32649"
  },
  "time_origin": "all deadline and schedule values are seconds after common t=0",
  "soc": "0-1 internally; *_pct fields preserve original percent values",
  "source": "official D-problem attachments; source_row is original Excel row",
  "files": {
    "nodes.csv": {
      "key": "node_id",
      "nullable": [
        "population (O01 only)"
      ],
      "units": "lon/lat degree; x/y/elevation m",
      "fields": {
        "node_id": {
          "type": "string",
          "unit": "",
          "nullable": false,
          "source_column": [
            "调度中心编号",
            "服务区编号"
          ]
        },
        "kind": {
          "type": "string",
          "unit": "",
          "nullable": false,
          "source_column": "derived"
        },
        "name": {
          "type": "string",
          "unit": "",
          "nullable": false,
          "source_column": [
            "调度中心名称",
            "服务区名称"
          ]
        },
        "lon_deg": {
          "type": "number",
          "unit": "degree",
          "nullable": false,
          "source_column": [
            "经度（°）"
          ]
        },
        "lat_deg": {
          "type": "number",
          "unit": "degree",
          "nullable": false,
          "source_column": [
            "纬度（°）"
          ]
        },
        "ground_elev_m": {
          "type": "number",
          "unit": "m",
