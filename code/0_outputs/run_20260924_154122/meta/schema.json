          "source_column": [
            "海拔（m）"
          ]
        },
        "x_m": {
          "type": "number",
          "unit": "m",
          "nullable": false,
          "source_column": "derived"
        },
        "y_m": {
          "type": "number",
          "unit": "m",
          "nullable": false,
          "source_column": "derived"
        },
        "operation_alt_m": {
          "type": "number",
          "unit": "m",
          "nullable": false,
          "source_column": "derived"
        },
        "population": {
          "type": "integer",
          "unit": "count",
          "nullable": true,
          "source_column": [
            "本次需保障人口（人）"
          ]
        },
        "source_file": {
          "type": "string",
          "unit": "",
          "nullable": false,
          "source_column": "Excel provenance"
        },
        "source_sheet": {
          "type": "string",
          "unit": "",
          "nullable": false,
          "source_column": "Excel provenance"
        },
        "source_row": {
          "type": "integer",
          "unit": "",
          "nullable": false,
